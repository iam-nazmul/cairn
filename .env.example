# Copy to .env and fill in. `.env` is gitignored.

# Selects the checkpointer/store backend. dev = in-memory, local = SQLite,
# prod = Postgres. Graph code is identical across all three.
ENV=dev

# --- LLM ---
# "ollama"  -> local Ollama server (no API key, no cloud).
# "fake"    -> deterministic scripted model in src/rag/llm.py, used by the test
#              suite so the quality gates run offline. Tests set this explicitly,
#              so they stay deterministic regardless of what is set here.
# anything else goes through LangChain's init_chat_model (openai, anthropic, ...).
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
LLM_TEMPERATURE=0.0

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
# Ollama defaults to a 4096-token window and silently drops the oldest tokens,
# which looks exactly like the bot forgetting earlier turns. Keep this generous.
OLLAMA_NUM_CTX=8192

# --- Backends ---
# ENV=local
SQLITE_PATH=cairn-checkpoints.db
# ENV=prod
DATABASE_URL=

# --- Long-term memory (Store) ---
# rules = deterministic extraction ("remember that ...", "my <attr> is <value>",
#         "I prefer ..."). Runs in the gates without a model.
# llm   = model-driven extraction: better recall, but one extra model call on the
#         write path of EVERY turn, and paraphrases produce duplicate rows.
# off   = never write durable facts.
MEMORY_EXTRACTION=rules
MAX_LONG_TERM_FACTS=50

# --- Retrieval and context budget ---
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.05
MAX_CONTEXT_CHARS=4000
