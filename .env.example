# Copy to .env and adjust. `.env` is gitignored; this file is the checked-in
# reference for every variable the app reads. Values below are the defaults from
# src/config.py unless noted.
#
#   cp .env.example .env

# =============================================================================
# Docker Compose (read by Compose itself, not by the app)
# =============================================================================
# LINUX ONLY, and only if Ollama runs on your host with its default 127.0.0.1
# bind. Uncomment to run the API in the host network namespace, so the container
# reaches Ollama with no OLLAMA_HOST edit and no root:
#
# COMPOSE_FILE=docker-compose.yml:docker-compose.host-net.yml
#
# Compose reads COMPOSE_FILE from THIS FILE, so a plain `docker compose up`
# then picks up docker-compose.host-net.yml on its own. Without it you must pass
# both files every time -- and a plain `docker compose up` silently recreates the
# container on bridge networking, where every turn fails with
# "Cannot reach Ollama at http://host.docker.internal:11434".
#
# Do NOT uncomment on Docker Desktop (macOS/Windows): the "host" there is a VM,
# so host networking buys nothing. Set OLLAMA_HOST=0.0.0.0:11434 instead.

# =============================================================================
# Backend selection
# =============================================================================
# dev   = in-memory checkpointer + store. Fast, resets on restart.
# local = SQLite checkpointer at SQLITE_PATH, in-memory store. Durable, one node.
# prod  = Postgres for BOTH the checkpointer and the store (SPEC §11).
# Graph code is identical across all three; only the backend instance differs.
ENV=dev

# =============================================================================
# LLM
# =============================================================================
# ollama = local Ollama server, no API key and no cloud round-trip.
# fake   = deterministic scripted model in src/rag/llm.py. The test suite sets
#          this explicitly, so the gates stay offline whatever is set here.
# other  = goes through LangChain's init_chat_model (openai, anthropic, ...).
LLM_PROVIDER=ollama

# Required for any provider except "fake". `ollama ls` shows what you have pulled.
# Note: thinking models (e.g. qwen3) emit their reasoning inline, which lands in
# the answer text.
LLM_MODEL=llama3.1

# 0.0 keeps answers reproducible, which matters for the citation eval.
LLM_TEMPERATURE=0.0

# --- Ollama-specific (ignored by other providers) ---
#
# !! OLLAMA_BASE_URL HERE DOES NOTHING IN DOCKER. Setting it below configures a
# HOST run only (`uv run uvicorn ...`). In Docker the address is set by Compose,
# and the knob is spelled DOCKER_OLLAMA_BASE_URL -- see the table.
#
# There is no single correct value, which is why nothing is assigned: `localhost`
# means this machine to uvicorn and the CONTAINER to a container, and only one of
# those can reach an Ollama running on your host.
#
#   How you run it                  Address used            Where it comes from
#   ------------------------------  ----------------------  --------------------
#   uv run uvicorn (host)           localhost:11434         src/config.py default
#                                                           override: OLLAMA_BASE_URL here
#   docker compose up               host.docker.internal    docker-compose.yml
#     (needs OLLAMA_HOST=0.0.0.0    :11434                  override: DOCKER_OLLAMA_BASE_URL
#      on the host -- see below)
#   + docker-compose.host-net.yml   localhost:11434         docker-compose.host-net.yml
#     (Linux; container shares the                          override: DOCKER_OLLAMA_BASE_URL
#      host's network namespace)
#
# So: uncomment this ONLY to point a HOST run at a non-default address. To change
# what a CONTAINER talks to, set DOCKER_OLLAMA_BASE_URL instead -- e.g.
# DOCKER_OLLAMA_BASE_URL=http://ollama:11434 for `--profile ollama`.
#
# OLLAMA_BASE_URL=http://localhost:11434
# Ollama defaults to a 4096-token window and silently drops the OLDEST tokens
# once history plus retrieved context exceeds it -- indistinguishable from the
# bot forgetting earlier turns. Keep this comfortably above MAX_HISTORY_TOKENS
# plus MAX_CONTEXT_CHARS.
OLLAMA_NUM_CTX=8192

# =============================================================================
# Persistence
# =============================================================================
# ENV=local only.
SQLITE_PATH=cairn-checkpoints.db

# ENV=prod only. ONE database backs both the checkpointer and the Store, so that
# deleting a user spans both in one place (SPEC §11). Matches docker-compose.yml:
#   docker compose up -d
DATABASE_URL=postgresql://cairn:cairn@localhost:5433/cairn?sslmode=disable

# =============================================================================
# Long-term memory (Store)
# =============================================================================
# How write_memory extracts durable facts (SPEC §11, resolved in M3):
#   rules = deterministic patterns -- "remember that ...", "my <attr> is <value>",
#           "I prefer ...". Precise, runs in the gates without a model, and gives
#           stable keys so restating a fact updates it instead of duplicating it.
#   llm   = model-driven extraction. Better recall, but one extra model call on
#           the write path of EVERY turn, and two phrasings of one fact produce
#           two rows.
#   off   = never write durable facts.
MEMORY_EXTRACTION=rules

# Upper bound on facts loaded into the prompt per turn.
MAX_LONG_TERM_FACTS=50

# =============================================================================
# Retrieval and context budget (SPEC §10 cost control)
# =============================================================================
RETRIEVAL_TOP_K=4

# Below this top score, the turn is routed to the clarify / no-answer path rather
# than answered from model priors.
RETRIEVAL_MIN_SCORE=0.05

# Cap on retrieved context in the prompt. Chunks are dropped whole, lowest-ranked
# first, so a citation marker never points at a truncated block.
MAX_CONTEXT_CHARS=4000

# History budget per model call. Older turns are trimmed from the PROMPT only --
# the checkpoint keeps the entire thread and /threads/{id}/history returns all of it.
MAX_HISTORY_TOKENS=1500

# =============================================================================
# Agent mode (the UI's second mode; "mode": "agent" on /chat)
# =============================================================================
# Chat mode searches once. Agent mode may search again, rewriting the query from
# what came back, and answers from everything it gathered. Both must cite -- the
# mode changes how evidence is found, never whether an answer needs any.
#
# Searches allowed per turn, counting the first. Each EXTRA one costs a model
# call to rewrite the query, so this is the cost ceiling for a turn. Set to 1 and
# agent mode behaves exactly like chat.
AGENT_MAX_SEARCHES=3

# Stop searching once the best chunk scores at least this. Above it, retrieval is
# already good and another rewrite just re-finds what is there.
AGENT_GOOD_SCORE=0.5

# =============================================================================
# Tools and approval (SPEC §13.3)
# =============================================================================
# Lets the model request a tool instead of answering. Anything with an external
# effect stops the run and waits for a human decision before it happens.
# Requires ENV=local or ENV=prod: the in-memory checkpointer drops a pending
# approval on restart, which abandons the turn silently.
TOOLS_ENABLED=false

# Tool calls allowed per turn. Each one costs another pass through generate.
TOOL_MAX_CALLS=2

# How long a pending approval stays valid. Past this, resuming is refused with
# 410 -- a week-old intention may no longer be wanted.
APPROVAL_TTL_SECONDS=86400

# =============================================================================
# Observability
# =============================================================================
# Level for the "cairn" logger: per-node timing, retrieval hits and scores, facts
# loaded, and approximate answer tokens, each tagged with thread_id. Third-party
# libraries are left at WARNING, so INFO here does not pull in their noise.
# Use DEBUG for more, WARNING to silence the per-node lines.
LOG_LEVEL=INFO

# =============================================================================
# Test-only (not read by the app; consumed by the test suite)
# =============================================================================
# Runs the Postgres memory tests, which are skipped without it:
#   uv run pytest -m postgres
POSTGRES_TEST_URI=

# Set to 1 to run the live Ollama tests, which are skipped by default because
# they are slow and need a running server:
#   CAIRN_TEST_OLLAMA=1 uv run pytest -m ollama
CAIRN_TEST_OLLAMA=
# Model those live tests use. Defaults to llama3.1 when unset.
CAIRN_TEST_OLLAMA_MODEL=
