# Copy to .env and fill in. `.env` is gitignored.

# Selects the checkpointer/store backend. dev = in-memory, local = SQLite,
# prod = Postgres. Graph code is identical across all three.
ENV=dev

# --- LLM ---
# "fake" selects the deterministic scripted model in src/rag/llm.py: no API key,
# no network, used by the test suite. Set a real provider for real answers.
LLM_PROVIDER=fake
LLM_MODEL=

# --- Backends ---
# ENV=local
SQLITE_PATH=cairn-checkpoints.db
# ENV=prod
DATABASE_URL=

# --- Retrieval and context budget ---
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.05
MAX_CONTEXT_CHARS=4000
