# Copy to .env and adjust. `.env` is gitignored; this file is the checked-in
# reference for every variable the app reads. Values below are the defaults from
# src/config.py unless noted.
#
#   cp .env.example .env

# =============================================================================
# Backend selection
# =============================================================================
# dev   = in-memory checkpointer + store. Fast, resets on restart.
# local = SQLite checkpointer at SQLITE_PATH, in-memory store. Durable, one node.
# prod  = Postgres for BOTH the checkpointer and the store (SPEC §11).
# Graph code is identical across all three; only the backend instance differs.
ENV=dev

# =============================================================================
# LLM
# =============================================================================
# ollama = local Ollama server, no API key and no cloud round-trip.
# fake   = deterministic scripted model in src/rag/llm.py. The test suite sets
#          this explicitly, so the gates stay offline whatever is set here.
# other  = goes through LangChain's init_chat_model (openai, anthropic, ...).
LLM_PROVIDER=ollama

# Required for any provider except "fake". `ollama ls` shows what you have pulled.
# Note: thinking models (e.g. qwen3) emit their reasoning inline, which lands in
# the answer text.
LLM_MODEL=llama3.1

# 0.0 keeps answers reproducible, which matters for the citation eval.
LLM_TEMPERATURE=0.0

# --- Ollama-specific (ignored by other providers) ---
# This value is for running the app ON THIS MACHINE (`uv run uvicorn ...`).
#
# It does NOT apply in Docker: inside a container `localhost` is the container
# itself, so it could never reach Ollama on your host. docker-compose.yml passes
# http://host.docker.internal:11434 instead, and reads its override from
# DOCKER_OLLAMA_BASE_URL -- a different name on purpose, so what you set here for
# a host run cannot leak into the container through Compose's ${VAR} substitution.
OLLAMA_BASE_URL=http://localhost:11434
# Ollama defaults to a 4096-token window and silently drops the OLDEST tokens
# once history plus retrieved context exceeds it -- indistinguishable from the
# bot forgetting earlier turns. Keep this comfortably above MAX_HISTORY_TOKENS
# plus MAX_CONTEXT_CHARS.
OLLAMA_NUM_CTX=8192

# =============================================================================
# Persistence
# =============================================================================
# ENV=local only.
SQLITE_PATH=cairn-checkpoints.db

# ENV=prod only. ONE database backs both the checkpointer and the Store, so that
# deleting a user spans both in one place (SPEC §11). Matches docker-compose.yml:
#   docker compose up -d
DATABASE_URL=postgresql://cairn:cairn@localhost:5433/cairn?sslmode=disable

# =============================================================================
# Long-term memory (Store)
# =============================================================================
# How write_memory extracts durable facts (SPEC §11, resolved in M3):
#   rules = deterministic patterns -- "remember that ...", "my <attr> is <value>",
#           "I prefer ...". Precise, runs in the gates without a model, and gives
#           stable keys so restating a fact updates it instead of duplicating it.
#   llm   = model-driven extraction. Better recall, but one extra model call on
#           the write path of EVERY turn, and two phrasings of one fact produce
#           two rows.
#   off   = never write durable facts.
MEMORY_EXTRACTION=rules

# Upper bound on facts loaded into the prompt per turn.
MAX_LONG_TERM_FACTS=50

# =============================================================================
# Retrieval and context budget (SPEC §10 cost control)
# =============================================================================
RETRIEVAL_TOP_K=4

# Below this top score, the turn is routed to the clarify / no-answer path rather
# than answered from model priors.
RETRIEVAL_MIN_SCORE=0.05

# Cap on retrieved context in the prompt. Chunks are dropped whole, lowest-ranked
# first, so a citation marker never points at a truncated block.
MAX_CONTEXT_CHARS=4000

# History budget per model call. Older turns are trimmed from the PROMPT only --
# the checkpoint keeps the entire thread and /threads/{id}/history returns all of it.
MAX_HISTORY_TOKENS=1500

# =============================================================================
# Observability
# =============================================================================
# Level for the "cairn" logger: per-node timing, retrieval hits and scores, facts
# loaded, and approximate answer tokens, each tagged with thread_id. Third-party
# libraries are left at WARNING, so INFO here does not pull in their noise.
# Use DEBUG for more, WARNING to silence the per-node lines.
LOG_LEVEL=INFO

# =============================================================================
# Test-only (not read by the app; consumed by the test suite)
# =============================================================================
# Runs the Postgres memory tests, which are skipped without it:
#   uv run pytest -m postgres
POSTGRES_TEST_URI=

# Set to 1 to run the live Ollama tests, which are skipped by default because
# they are slow and need a running server:
#   CAIRN_TEST_OLLAMA=1 uv run pytest -m ollama
CAIRN_TEST_OLLAMA=
# Model those live tests use. Defaults to llama3.1 when unset.
CAIRN_TEST_OLLAMA_MODEL=
