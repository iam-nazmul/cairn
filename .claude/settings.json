{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(uv add:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run python:*)",
      "Bash(uv run uvicorn:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",

      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(tree:*)",

      "Read",
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(.claude/**)",

      "WebFetch(domain:langchain-ai.github.io)",
      "WebFetch(domain:python.langchain.com)",
      "WebFetch(domain:fastapi.tiangolo.com)",
      "WebFetch(domain:docs.pydantic.dev)"
    ],

    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/venv/**)",
      "Read(**/.venv/**)",
      "Bash(cat .env*)",
      "Bash(cat **/.env*)",
      "Bash(rm -rf *)"
    ],

    "ask": [
      "Bash(git push:*)",
      "Bash(uv run alembic:*)",
      "Bash(psql:*)",
      "Bash(docker compose down:*)"
    ]
  },

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "ruff format",
            "timeout": 30,
            "command": "{ jq -r '.tool_response.filePath // .tool_input.file_path // empty' | { read -r f; case \"$f\" in *.py) uv run ruff format \"$f\";; esac; }; } 2>/dev/null || true"
          },
          {
            "type": "command",
            "statusMessage": "pytest",
            "timeout": 180,
            "command": "{ jq -r '.tool_response.filePath // .tool_input.file_path // empty' | { read -r f; case \"$f\" in *.py) uv run pytest -q;; esac; }; } 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
